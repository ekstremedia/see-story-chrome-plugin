{
  "manifest_version": 3,
  "name": "AmediAid",
  "version": "2.0.0",
  "description": "Clears Amedia local-newspaper paywalls automatically, plus one click to strip CSS blur, fade-out masks and scroll locks anywhere else.",
  "permissions": ["scripting", "activeTab", "storage"],
  "optional_host_permissions": [
    "*://*.aasavis.no/*",
    "*://*.akersposten.no/*",
    "*://*.amta.no/*",
    "*://*.an.no/*",
    "*://*.ao.no/*",
    "*://*.auraavis.no/*",
    "*://*.austagderblad.no/*",
    "*://*.avisa-hordaland.no/*",
    "*://*.ba.no/*",
    "*://*.blv.no/*",
    "*://*.budstikka.no/*",
    "*://*.bygdeposten.no/*",
    "*://*.eikerbladet.no/*",
    "*://*.enebakkavis.no/*",
    "*://*.f-b.no/*",
    "*://*.fd.no/*",
    "*://*.finnmarken.no/*",
    "*://*.finnmarksposten.no/*",
    "*://*.firda.no/*",
    "*://*.firdaposten.no/*",
    "*://*.fremover.no/*",
    "*://*.gbnett.no/*",
    "*://*.gd.no/*",
    "*://*.gjengangeren.no/*",
    "*://*.glomdalen.no/*",
    "*://*.h-avis.no/*",
    "*://*.ha-halden.no/*",
    "*://*.hadeland.no/*",
    "*://*.hardanger-folkeblad.no/*",
    "*://*.helg.no/*",
    "*://*.iharstad.no/*",
    "*://*.indre.no/*",
    "*://*.jarlsbergavis.no/*",
    "*://*.krs.no/*",
    "*://*.kv.no/*",
    "*://*.kvinnheringen.no/*",
    "*://*.laagendalsposten.no/*",
    "*://*.lierposten.no/*",
    "*://*.lofot-tidende.no/*",
    "*://*.lofotposten.no/*",
    "*://*.moss-avis.no/*",
    "*://*.nab.no/*",
    "*://*.namdalsavisa.no/*",
    "*://*.noblad.no/*",
    "*://*.nordhordland.no/*",
    "*://*.nordlys.no/*",
    "*://*.oa.no/*",
    "*://*.oblad.no/*",
    "*://*.op.no/*",
    "*://*.ostlendingen.no/*",
    "*://*.oyene.no/*",
    "*://*.pd.no/*",
    "*://*.r-a.no/*",
    "*://*.rablad.no/*",
    "*://*.ranablad.no/*",
    "*://*.rb.no/*",
    "*://*.retten.no/*",
    "*://*.ringblad.no/*",
    "*://*.ringsaker-blad.no/*",
    "*://*.rogavis.no/*",
    "*://*.sa.no/*",
    "*://*.sb.no/*",
    "*://*.smaalenene.no/*",
    "*://*.solungavisa.no/*",
    "*://*.sva.no/*",
    "*://*.svelviksposten.no/*",
    "*://*.ta.no/*",
    "*://*.tb.no/*",
    "*://*.telen.no/*",
    "*://*.tk.no/*",
    "*://*.totenidag.no/*",
    "*://*.tvedestrandsposten.no/*",
    "*://*.varingen.no/*",
    "*://*.vestbyavis.no/*",
    "*://*.vestviken24.no/*"
