{
  "manifest_version": 3,
  "name": "Clear View",
  "version": "2.0.0",
  "description": "One click to strip CSS blur, fade-out masks and scroll locks from a page, plus your own per-site element rules.",
  "permissions": ["scripting", "activeTab", "storage"],
  "action": {
    "default_title": "Clear View - un-blur this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Clear the current page"
    }
  },
  "background": { "service_worker": "background.js" }
}
